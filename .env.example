# ===================================
# NioticBot - Configuration .env
# ===================================

# Token du bot Discord (obligatoire)
DISCORD_TOKEN=votre_token_ici

# ID du client/bot Discord (obligatoire)
CLIENT_ID=votre_client_id_ici

# ID du serveur principal (optionnel, pour déploiement des commandes sur un seul serveur)
GUILD_ID=votre_guild_id_ici

# ===================================
# Base de données MongoDB
# ===================================

# Option 1: MongoDB Atlas (Cloud)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nioticbot?retryWrites=true&w=majority

# Option 2: MongoDB Local
# MONGODB_URI=mongodb://localhost:27017/nioticbot

# ===================================
# Configuration optionnelle
# ===================================

# Langue par défaut (fr ou en)
DEFAULT_LANGUAGE=fr

# Niveau de logs (debug, info, warn, error)
LOG_LEVEL=info

# Environnement (development ou production)
NODE_ENV=production
